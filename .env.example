# --- Application -----------------------------------------------------------
# Public base URL of this instance. Must match the redirect URI configured in
# your identity provider.
APP_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# SQLite file. docker-compose.yml overrides this with /data/kassenknoten.db, which is
# the mounted volume; the value here is for running the app directly.
DATABASE_PATH=./data/kassenknoten.db

# --- Sessions --------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 32`. Rotating it logs everyone out.
SESSION_SECRET=

# --- Authentication --------------------------------------------------------
# Currently only "local": one shared household password. OIDC (Authentik) follows,
# and the value is rejected until the code behind it exists.
AUTH_MODE=local

# The shared household password, as the base64-encoded argon2id hash printed by
# `npm run auth:hash`. Base64 on purpose: a raw argon2id hash is full of `$`, and both
# .env parsers and docker-compose expand those as variables, which silently destroys it.
# A raw hash is still accepted if you can guarantee it reaches the process intact.
LOCAL_PASSWORD_HASH=

# Alternative to the above: read the hash from a file, e.g. a Docker secret.
# Takes precedence over LOCAL_PASSWORD_HASH when set.
LOCAL_PASSWORD_HASH_FILE=

# --- Container ---------------------------------------------------------------
# Read by the Next.js standalone server. Both are already set in the Dockerfile; they
# are listed here so a deployment that does not use it knows they exist.
# PORT=3000
# HOSTNAME=0.0.0.0
