# --- Application -----------------------------------------------------------
# Public base URL of this instance. Must match the redirect URI configured in
# your identity provider.
APP_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# SQLite file. In Docker this points at a mounted volume.
DATABASE_PATH=./data/kassenknoten.db

# --- Sessions --------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 32`. Rotating it logs everyone out.
SESSION_SECRET=

# --- Authentication --------------------------------------------------------
# oidc  = only your identity provider (recommended)
# local = only the shared household password
# both  = OIDC with the password form as a fallback
AUTH_MODE=oidc

# Comma-separated list of e-mail addresses allowed to sign in. Anyone else is
# rejected even if your identity provider authenticated them successfully.
AUTH_ALLOWED_EMAILS=

# OpenID Connect provider (Authentik, Authelia, Keycloak, Zitadel, ...).
# The issuer URL is the one serving /.well-known/openid-configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# argon2id hash of the shared household password, only for AUTH_MODE=local|both.
LOCAL_PASSWORD_HASH=
