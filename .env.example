# --- Application -----------------------------------------------------------
# Public base URL of this instance. Must match the redirect URI configured in
# your identity provider.
APP_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# SQLite file. docker-compose.yml overrides this with /data/kassenknoten.db, which is
# the mounted volume; the value here is for running the app directly.
DATABASE_PATH=./data/kassenknoten.db

# --- Sessions --------------------------------------------------------------
# 32+ random bytes. The image prints one, on any system:
#   docker run --rm ghcr.io/jankln/kassenknoten node scripts/session-secret.ts
# (from a checkout: npm run auth:secret). Rotating it logs everyone out.
SESSION_SECRET=

# --- Authentication --------------------------------------------------------
# Which ways of signing in are switched on at the first start:
#   local  the shared household password (LOCAL_PASSWORD_HASH below)
#   oidc   your identity provider only (the OIDC_* block further down)
#   both   either of them
#
# This is only the starting point. Once the household changes it under
# Settings -> Sign-in, the settings win and this value no longer applies. A provider that
# is configured below but not switched on here can be switched on there later, without a
# restart.
AUTH_MODE=local

# The shared household password, as the base64-encoded argon2id hash printed by
#   docker run -it --rm ghcr.io/jankln/kassenknoten node scripts/hash-password.ts
# (from a checkout: npm run auth:hash). Base64 on purpose: a raw argon2id hash is full of `$`, and both
# .env parsers and docker-compose expand those as variables, which silently destroys it.
# A raw hash is still accepted if you can guarantee it reaches the process intact.
LOCAL_PASSWORD_HASH=

# Alternative to the above: read the hash from a file, e.g. a Docker secret.
# Takes precedence over LOCAL_PASSWORD_HASH when set.
LOCAL_PASSWORD_HASH_FILE=

# LOCAL_PASSWORD_HASH may be left empty only with AUTH_MODE=oidc. Keeping it set anyway
# means the password can be switched back on in the settings if the provider ever fails.

# --- Identity provider (optional) --------------------------------------------
# Sign in with Authentik, or any other OpenID Connect provider, instead of or next to the
# password. Leave OIDC_ISSUER and OIDC_CLIENT_ID empty and nothing about sign-in changes.
#
# Register this instance at the provider as a confidential client using the
# authorization code flow, with the redirect URI
#   <APP_URL>/login/oidc/callback
# APP_URL above has to be the address the browser uses, or the provider refuses it.
#
# The issuer exactly as the provider names it, trailing slash included. For Authentik:
#   https://auth.example.com/application/o/<application-slug>/
OIDC_ISSUER=
OIDC_CLIENT_ID=
# The client secret stays here and never reaches the database. Empty for a public client.
OIDC_CLIENT_SECRET=
# Alternative to the above: read the secret from a file, e.g. a Docker secret.
OIDC_CLIENT_SECRET_FILE=
# What the sign-in button calls the provider, e.g. "Authentik".
OIDC_PROVIDER_NAME=
# Who may sign in through the provider, comma-separated. Having an account there is not
# enough. This seeds the list; after install it is kept under Settings -> Sign-in, and
# the first change there takes over from this line. Required for AUTH_MODE=oidc.
OIDC_ALLOWED_EMAILS=
#
# If the provider breaks while it is the only way in: remove OIDC_ISSUER and
# OIDC_CLIENT_ID, set AUTH_MODE=local with a LOCAL_PASSWORD_HASH, and restart.

# --- Second factor (optional) ----------------------------------------------
# Base32 secret for a six-digit code from an authenticator app, printed together with a
# QR code by
#   docker run -it --rm ghcr.io/jankln/kassenknoten node scripts/totp-secret.ts
# (from a checkout: npm run auth:totp). Leave empty for password-only sign-in. It applies to the
# household password; a provider sign-in gets its second factor from the provider.
#
# It lives here rather than in the database on purpose: a copy of the SQLite file must not
# be a copy of the second factor. That also means losing your phone is not a lockout — the
# secret is still in this file and can simply be scanned again, so there are no recovery
# codes to keep.
#
# Base32 is A-Z and 2-7, so unlike the argon2id hash it survives .env and docker-compose
# without any encoding.
TOTP_SECRET=

# --- Extensions --------------------------------------------------------------
# Extensions are your own code, uploaded in the settings. They run on this server, inside
# the application process, with full access to your household's database — installing one
# is installing software on your machine. See docs/extensions/README.md.
#
# Set this to false and restart to load none of them at all. That is the way out when an
# extension breaks the app badly enough that you cannot reach the screen to remove it.
# EXTENSIONS_ENABLED=false
#
# Where the uploaded files live. Inside the data volume by default, so they survive an
# upgrade of the image.
# EXTENSIONS_DIR=/data/extensions

# --- Automatic backups -------------------------------------------------------
# Once a day, when something has changed, the server writes the same JSON backup the
# settings screen downloads, and keeps the newest BACKUP_KEEP of them. They are listed,
# and can be downloaded, under Settings -> Data.
#
# They are on the same disk as the database. Copy the folder somewhere else from time to
# time: a backup on the disk that fails goes with it.
#
# Where they go. Defaults to backups/ beside the database — /data/backups in the image,
# inside the data volume.
BACKUP_DIR=
# How many distinct backups are kept. 0 switches automatic backups off.
BACKUP_KEEP=

# --- Container ---------------------------------------------------------------
# Read by the Next.js standalone server. Both are already set in the Dockerfile; they
# are listed here so a deployment that does not use it knows they exist.
# PORT=3000
# HOSTNAME=0.0.0.0
